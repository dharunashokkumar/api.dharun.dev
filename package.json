{
  "name": "indian-listed-company-logos",
  "version": "2.0.0",
  "private": true,
  "description": "Logo API and searchable directory for companies listed on India's NSE and BSE.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "validate": "node tools/validate-site.mjs",
    "build:data": "node tools/build-data.mjs",
    "build:release": "bash tools/build-release.sh",
    "normalize:svgs": "node tools/normalize-svgs.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
