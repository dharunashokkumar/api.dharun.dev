{
 "title": "ஆத்திசூடி",
 "title_en": "Aathichoodi",
 "author": "Avvaiyar",
 "language": "ta",
 "invocation": [
  "ஆத்தி சூடி அமர்ந்த தேவனை",
  "ஏத்தி யேத்தித் தொழுவோம் யாமே."
 ],
 "source": "https://ta.wikisource.org/wiki/ஆத்திசூடி",
 "revision": 1731286,
 "lines": [
  {
   "number": 1,
   "section": "உயிர் வருக்கம்",
   "text": "அறம் செய விரும்பு"
  },
  {
   "number": 2,
   "section": "உயிர் வருக்கம்",
   "text": "ஆறுவது சினம்"
  },
  {
   "number": 3,
   "section": "உயிர் வருக்கம்",
   "text": "இயல்வது கரவேல்"
  },
  {
   "number": 4,
   "section": "உயிர் வருக்கம்",
   "text": "ஈவது விலக்கேல்"
  },
  {
   "number": 5,
   "section": "உயிர் வருக்கம்",
   "text": "உடையது விளம்பேல்"
  },
  {
   "number": 6,
   "section": "உயிர் வருக்கம்",
   "text": "ஊக்கமது கைவிடேல்"
  },
  {
   "number": 7,
   "section": "உயிர் வருக்கம்",
   "text": "எண் எழுத்து இகழேல்"
  },
  {
   "number": 8,
   "section": "உயிர் வருக்கம்",
   "text": "ஏற்பது இகழ்ச்சி"
  },
  {
   "number": 9,
   "section": "உயிர் வருக்கம்",
   "text": "ஐயம் இட்டு உண்"
  },
  {
   "number": 10,
   "section": "உயிர் வருக்கம்",
   "text": "ஒப்புரவு ஒழுகு"
  },
  {
   "number": 11,
   "section": "உயிர் வருக்கம்",
   "text": "ஓதுவது ஒழியேல்"
  },
  {
   "number": 12,
   "section": "உயிர் வருக்கம்",
   "text": "ஔவியம் பேசேல்"
  },
  {
   "number": 13,
   "section": "உயிர் வருக்கம்",
   "text": "அஃகம் சுருக்கேல்"
  },
  {
   "number": 14,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "கண்டொன்று சொல்லேல்"
  },
  {
   "number": 15,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "ஙப் போல் வளை"
  },
  {
   "number": 16,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "சனி நீராடு"
  },
  {
   "number": 17,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "ஞயம்பட உரை"
  },
  {
   "number": 18,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "இடம்பட வீடு எடேல்"
  },
  {
   "number": 19,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "இணக்கம் அறிந்து இணங்கு"
  },
  {
   "number": 20,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "தந்தை தாய்ப் பேண்"
  },
  {
   "number": 21,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "நன்றி மறவேல்"
  },
  {
   "number": 22,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "பருவத்தே பயிர் செய்"
  },
  {
   "number": 23,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "மண் பறித்து உண்ணேல்"
  },
  {
   "number": 24,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "இயல்பு அலாதன செய்யேல்"
  },
  {
   "number": 25,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "அரவம் ஆட்டேல்"
  },
  {
   "number": 26,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "இலவம் பஞ்சில் துயில்"
  },
  {
   "number": 27,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "வஞ்சகம் பேசேல்"
  },
  {
   "number": 28,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "அழகு அலாதன செய்யேல்"
  },
  {
   "number": 29,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "இளமையில் கல்"
  },
  {
   "number": 30,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "அறனை மறவேல்"
  },
  {
   "number": 31,
   "section": "உயிர்மெய் வருக்கம்",
   "text": "அனந்தல் ஆடேல்"
  },
  {
   "number": 32,
   "section": "ககர வருக்கம்",
   "text": "கடிவது மற"
  },
  {
   "number": 33,
   "section": "ககர வருக்கம்",
   "text": "காப்பது விரதம்"
  },
  {
   "number": 34,
   "section": "ககர வருக்கம்",
   "text": "கிழமைப்பட வாழ்"
  },
  {
   "number": 35,
   "section": "ககர வருக்கம்",
   "text": "கீழ்மை அகற்று"
  },
  {
   "number": 36,
   "section": "ககர வருக்கம்",
   "text": "குணமது கைவிடேல்"
  },
  {
   "number": 37,
   "section": "ககர வருக்கம்",
   "text": "கூடிப் பிரியேல்"
  },
  {
   "number": 38,
   "section": "ககர வருக்கம்",
   "text": "கெடுப்பது ஒழி"
  },
  {
   "number": 39,
   "section": "ககர வருக்கம்",
   "text": "கேள்வி முயல்"
  },
  {
   "number": 40,
   "section": "ககர வருக்கம்",
   "text": "கைவினை கரவேல்"
  },
  {
   "number": 41,
   "section": "ககர வருக்கம்",
   "text": "கொள்ளை விரும்பேல்"
  },
  {
   "number": 42,
   "section": "ககர வருக்கம்",
   "text": "கோதாட்டு ஒழி"
  },
  {
   "number": 43,
   "section": "ககர வருக்கம்",
   "text": "கௌவை அகற்று"
  },
  {
   "number": 44,
   "section": "சகர வருக்கம்",
   "text": "சக்கர நெறி நில்"
  },
  {
   "number": 45,
   "section": "சகர வருக்கம்",
   "text": "சான்றோர் இனத்து இரு"
  },
  {
   "number": 46,
   "section": "சகர வருக்கம்",
   "text": "சித்திரம் பேசேல்"
  },
  {
   "number": 47,
   "section": "சகர வருக்கம்",
   "text": "சீர்மை மறவேல்<"
  },
  {
   "number": 48,
   "section": "சகர வருக்கம்",
   "text": "சுளிக்கச் சொல்லேல்"
  },
  {
   "number": 49,
   "section": "சகர வருக்கம்",
   "text": "சூது விரும்பேல்"
  },
  {
   "number": 50,
   "section": "சகர வருக்கம்",
   "text": "செய்வன திருந்தச் செய்"
  },
  {
   "number": 51,
   "section": "சகர வருக்கம்",
   "text": "சேரிடம் அறிந்து சேர்"
  },
  {
   "number": 52,
   "section": "சகர வருக்கம்",
   "text": "சையெனத் திரியேல்"
  },
  {
   "number": 53,
   "section": "சகர வருக்கம்",
   "text": "சொற் சோர்வு படேல்"
  },
  {
   "number": 54,
   "section": "சகர வருக்கம்",
   "text": "சோம்பித் திரியேல்"
  },
  {
   "number": 55,
   "section": "தகர வருக்கம்",
   "text": "தக்கோன் எனத் திரி"
  },
  {
   "number": 56,
   "section": "தகர வருக்கம்",
   "text": "தானமது விரும்பு"
  },
  {
   "number": 57,
   "section": "தகர வருக்கம்",
   "text": "திருமாலுக்கு அடிமை செய்"
  },
  {
   "number": 58,
   "section": "தகர வருக்கம்",
   "text": "தீவினை அகற்று"
  },
  {
   "number": 59,
   "section": "தகர வருக்கம்",
   "text": "துன்பத்திற்கு இடம் கொடேல்"
  },
  {
   "number": 60,
   "section": "தகர வருக்கம்",
   "text": "தூக்கி வினை செய்"
  },
  {
   "number": 61,
   "section": "தகர வருக்கம்",
   "text": "தெய்வம் இகழேல்"
  },
  {
   "number": 62,
   "section": "தகர வருக்கம்",
   "text": "தேசத்தோடு ஒட்டி வாழ்"
  },
  {
   "number": 63,
   "section": "தகர வருக்கம்",
   "text": "தையல் சொல் கேளேல்"
  },
  {
   "number": 64,
   "section": "தகர வருக்கம்",
   "text": "தொன்மை மறவேல்"
  },
  {
   "number": 65,
   "section": "தகர வருக்கம்",
   "text": "தோற்பன தொடரேல்"
  },
  {
   "number": 66,
   "section": "நகர வருக்கம்",
   "text": "நன்மை கடைப்பிடி"
  },
  {
   "number": 67,
   "section": "நகர வருக்கம்",
   "text": "நாடு ஒப்பன செய்"
  },
  {
   "number": 68,
   "section": "நகர வருக்கம்",
   "text": "நிலையில் பிரியேல்"
  },
  {
   "number": 69,
   "section": "நகர வருக்கம்",
   "text": "நீர் விளையாடேல்"
  },
  {
   "number": 70,
   "section": "நகர வருக்கம்",
   "text": "நுண்மை நுகரேல்"
  },
  {
   "number": 71,
   "section": "நகர வருக்கம்",
   "text": "நூல் பல கல்"
  },
  {
   "number": 72,
   "section": "நகர வருக்கம்",
   "text": "நெற்பயிர் விளைவு செய்"
  },
  {
   "number": 73,
   "section": "நகர வருக்கம்",
   "text": "நேர்பட ஒழுகு"
  },
  {
   "number": 74,
   "section": "நகர வருக்கம்",
   "text": "நைவினை நணுகேல்"
  },
  {
   "number": 75,
   "section": "நகர வருக்கம்",
   "text": "நொய்ய உரையேல்"
  },
  {
   "number": 76,
   "section": "நகர வருக்கம்",
   "text": "நோய்க்கு இடம் கொடேல்"
  },
  {
   "number": 77,
   "section": "பகர வருக்கம்",
   "text": "பழிப்பன பகரேல்"
  },
  {
   "number": 78,
   "section": "பகர வருக்கம்",
   "text": "பாம்பொடு பழகேல்"
  },
  {
   "number": 79,
   "section": "பகர வருக்கம்",
   "text": "பிழைபடச் சொல்லேல்"
  },
  {
   "number": 80,
   "section": "பகர வருக்கம்",
   "text": "பீடு பெற நில்"
  },
  {
   "number": 81,
   "section": "பகர வருக்கம்",
   "text": "புகழ்ந்தாரைப் போற்றி வாழ்"
  },
  {
   "number": 82,
   "section": "பகர வருக்கம்",
   "text": "பூமி திருத்தி உண்"
  },
  {
   "number": 83,
   "section": "பகர வருக்கம்",
   "text": "பெரியாரைத் துணைக் கொள்"
  },
  {
   "number": 84,
   "section": "பகர வருக்கம்",
   "text": "பேதைமை அகற்று"
  },
  {
   "number": 85,
   "section": "பகர வருக்கம்",
   "text": "பையலோடு இணங்கேல்"
  },
  {
   "number": 86,
   "section": "பகர வருக்கம்",
   "text": "பொருள்தனைப் போற்றி வாழ்"
  },
  {
   "number": 87,
   "section": "பகர வருக்கம்",
   "text": "போர்த் தொழில் புரியேல்"
  },
  {
   "number": 88,
   "section": "மகர வருக்கம்",
   "text": "மனம் தடுமாறேல்"
  },
  {
   "number": 89,
   "section": "மகர வருக்கம்",
   "text": "மாற்றானுக்கு இடம் கொடேல்"
  },
  {
   "number": 90,
   "section": "மகர வருக்கம்",
   "text": "மிகைபடச் சொல்லேல்"
  },
  {
   "number": 91,
   "section": "மகர வருக்கம்",
   "text": "மீதூண் விரும்பேல்"
  },
  {
   "number": 92,
   "section": "மகர வருக்கம்",
   "text": "முனைமுகத்து நில்லேல்"
  },
  {
   "number": 93,
   "section": "மகர வருக்கம்",
   "text": "மூர்க்கரோடு இணங்கேல்"
  },
  {
   "number": 94,
   "section": "மகர வருக்கம்",
   "text": "மெல்லி நல்லாள் தோள்சேர்"
  },
  {
   "number": 95,
   "section": "மகர வருக்கம்",
   "text": "மேன்மக்கள் சொல் கேள்"
  },
  {
   "number": 96,
   "section": "மகர வருக்கம்",
   "text": "மை விழியார் மனை அகல்"
  },
  {
   "number": 97,
   "section": "மகர வருக்கம்",
   "text": "மொழிவது அற மொழி"
  },
  {
   "number": 98,
   "section": "மகர வருக்கம்",
   "text": "மோகத்தை முனி"
  },
  {
   "number": 99,
   "section": "வகர வருக்கம்",
   "text": "வல்லமை பேசேல்"
  },
  {
   "number": 100,
   "section": "வகர வருக்கம்",
   "text": "வாது முற்கூறேல்"
  },
  {
   "number": 101,
   "section": "வகர வருக்கம்",
   "text": "வித்தை விரும்பு"
  },
  {
   "number": 102,
   "section": "வகர வருக்கம்",
   "text": "வீடு பெற நில்"
  },
  {
   "number": 103,
   "section": "வகர வருக்கம்",
   "text": "உத்தமனாய் இரு"
  },
  {
   "number": 104,
   "section": "வகர வருக்கம்",
   "text": "ஊருடன் கூடி வாழ்"
  },
  {
   "number": 105,
   "section": "வகர வருக்கம்",
   "text": "வெட்டெனப் பேசேல்"
  },
  {
   "number": 106,
   "section": "வகர வருக்கம்",
   "text": "வேண்டி வினை செயேல்"
  },
  {
   "number": 107,
   "section": "வகர வருக்கம்",
   "text": "வைகறைத் துயில் எழு"
  },
  {
   "number": 108,
   "section": "வகர வருக்கம்",
   "text": "ஒன்னாரைத் தேறேல்"
  },
  {
   "number": 109,
   "section": "வகர வருக்கம்",
