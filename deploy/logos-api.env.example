# /etc/logos-api/logos-api.env (created by install.sh, never overwritten afterwards)

# Public listener: the reverse proxy or tunnel connects here.
HOST=0.0.0.0
PORT=8080

# Prometheus listener. Firewall it to the Prometheus host: /metrics is not on the public port.
METRICS_HOST=0.0.0.0
METRICS_PORT=9464

# Path this API is mounted under, so other APIs can share the hostname.
BASE_PATH=/logos
# Origin used in links, the sitemap and the OpenAPI document.
PUBLIC_ORIGIN=https://api.dharun.dev

# 1 = take the client address from CF-Connecting-IP / X-Forwarded-For for rate limiting.
# Only correct when the port is reachable solely through your proxy.
TRUST_PROXY=1
# Requests per minute per client on the API routes. 0 disables the limit.
RATE_LIMIT_PER_MIN=600
