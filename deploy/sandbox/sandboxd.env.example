# /etc/sandboxd/env: settings of the sandbox controller (install.sh writes it once).
# Only the API container may reach LISTEN; only Prometheus METRICS_LISTEN.
LISTEN=0.0.0.0:7070
METRICS_LISTEN=0.0.0.0:9465
SANDBOX_SECRET_FILE=/etc/sandboxd/secret
SANDBOX_HOME=/opt/sandbox
STATE_DIR=/var/lib/sandboxd
# Guest memory all microVMs may hold together. The VM has 4 GB: Postgres, the controller
# and the kernel keep the rest.
MEMORY_CAP_MB=2560
CODE_MEMORY_MB=256
BROWSER_MEMORY_MB=1024
# Code VMs kept booted for runs.
WARM=2
QUEUE_WAIT_SECONDS=10
BROWSER_PER_SITE=10
# The kill switch: while this file exists nothing new starts and every microVM is
# stopped. Its content is the reason. echo "reason" > /etc/sandboxd/paused
PAUSE_FILE=/etc/sandboxd/paused
POSTGRES=on
# The updater: where releases come from.
SANDBOX_REPO=dharunashokkumar/api.dharun.dev
