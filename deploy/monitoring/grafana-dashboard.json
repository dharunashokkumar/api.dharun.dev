{
 "uid": "dharun-api",
 "title": "api.dharun.dev",
 "description": "Requests served, per API, plus errors, speed and memory (Prometheus job dharun-api).",
 "tags": [
  "dharun-api"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   },
   {
    "name": "logs",
    "label": "Logs",
    "type": "datasource",
    "query": "loki",
    "current": {}
   },
   {
    "name": "log_stream",
    "label": "Log stream",
    "type": "textbox",
    "query": "{host=\"api\"}",
    "current": {
     "text": "{host=\"api\"}",
     "value": "{host=\"api\"}"
    },
    "description": "Loki stream selector for the API's journal (one JSON line per request)."
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Served, all time",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(api_lifetime_requests_total{job=\"dharun-api\"})",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Served in this time range",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(api_http_requests_total{job=\"dharun-api\",route!~\"health|preflight\"}[$__range]))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Unknown logo symbols in range",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(api_logo_requests_total{job=\"dharun-api\",result!=\"found\"}[$__range])) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "description": "Logo lookups in this time range whose symbol was not in the logo set (a fallback image or a 404). 0 when there were none."
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Version",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "name"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "api_build_info{job=\"dharun-api\"}",
     "legendFormat": "{{version}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Uptime",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - process_start_time_seconds{job=\"dharun-api\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "bargauge",
   "title": "Served all time, by API",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showUnfilled": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sort_desc(api_lifetime_requests_total{job=\"dharun-api\"})",
     "legendFormat": "{{route}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Requests per second by API",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(api_http_requests_total{job=\"dharun-api\",route!~\"health|preflight\"}[5m]))",
     "legendFormat": "{{route}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Responses by status",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(api_http_requests_total{job=\"dharun-api\",route!~\"health|preflight\"}[5m]))",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "95th percentile response time by API",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(api_http_request_duration_seconds_bucket{job=\"dharun-api\",route!~\"health|preflight\"}[5m])))",
     "legendFormat": "{{route}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Logo lookups by format and outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (format, result) (rate(api_logo_requests_total{job=\"dharun-api\"}[5m]))",
     "legendFormat": "{{format}} {{result}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Memory",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0,
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "process_resident_memory_bytes{job=\"dharun-api\"}",
     "legendFormat": "resident",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "go_memstats_heap_alloc_bytes{job=\"dharun-api\"}",
     "legendFormat": "Go heap",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Rate-limited requests per second",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 16,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(api_rate_limited_total{job=\"dharun-api\"}[5m])",
     "legendFormat": "rejected",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 14,
   "type": "row",
   "title": "Data",
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 15,
   "type": "stat",
   "title": "Refreshes failing",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 35,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(api_dataset_refresh_ok{job=\"dharun-api\"} == 0) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "description": "Datasets whose last refresh attempt failed or was held back by a sanity check. The copy in use keeps being served."
  },
  {
   "id": 16,
   "type": "stat",
   "title": "Datasets missing",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 4,
    "y": 35,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(api_dataset_available{job=\"dharun-api\"} == 0) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "description": "Datasets this server holds no copy of; their endpoints answer 503. The IP database is missing until its first refresh."
  },
  {
   "id": 17,
   "type": "stat",
   "title": "Heavy requests turned away",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 35,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(api_busy_total{job=\"dharun-api\"}[$__range]))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "description": "CPU-heavy requests refused with 503 because every slot stayed taken for ten seconds."
  },
  {
   "id": 18,
   "type": "stat",
   "title": "Last refresh, by dataset",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 35,
    "w": 12,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "failing"
        },
        "1": {
         "text": "ok"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "api_dataset_refresh_ok{job=\"dharun-api\"}",
     "legendFormat": "{{dataset}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "description": "Outcome of the last refresh attempt of each dataset this server refreshes itself."
  },
  {
   "id": 19,
   "type": "bargauge",
   "title": "Time since each dataset was last refreshed, against how often it should be",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1.5
       },
       {
        "color": "red",
        "value": 3
       }
      ]
     },
     "min": 0,
     "max": 4
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "orientation": "horizontal",
    "displayMode": "gradient"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(time() - api_dataset_refresh_success_timestamp_seconds{job=\"dharun-api\"}) / on (dataset, instance) api_dataset_refresh_interval_seconds{job=\"dharun-api\"}",
     "legendFormat": "{{dataset}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "description": "1 means one whole refresh interval has passed since a refresh last worked. Past 2 a refresh has been missed; the alert fires at 3."
  },
  {
   "id": 20,
   "type": "bargauge",
   "title": "Age of the data in use",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 3888000
       },
       {
        "color": "red",
        "value": 10368000
       }
      ]
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "orientation": "horizontal",
    "displayMode": "gradient"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - api_dataset_fetched_timestamp_seconds{job=\"dharun-api\"}",
     "legendFormat": "{{dataset}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "description": "How long ago the source of the copy being served was fetched. Datasets updated by hand (pincodes, logos, central government holidays) age until the next import."
  },
  {
   "id": 21,
   "type": "table",
   "title": "Copy in use",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 49,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "api_dataset_available{job=\"dharun-api\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "format": "table",
     "instant": true
    }
   ],
   "description": "seed: the copy that came with the release. server: a newer copy this server fetched. none: no copy.",
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true
      },
      "renameByName": {
       "dataset": "Dataset",
       "copy": "Copy",
       "Value": "Available"
      }
     }
    }
   ]
  },
  {
   "id": 22,
   "type": "bargauge",
   "title": "Records loaded, by dataset",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 49,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
