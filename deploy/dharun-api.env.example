# /etc/dharun-api/env (created by install.sh, never overwritten afterwards)

# Public listener: the reverse proxy or tunnel connects here.
HOST=0.0.0.0
PORT=8080

# Prometheus listener: /metrics and /stats (lifetime totals). Firewall it to the
# Prometheus host; neither path exists on the public port. 0 turns it off.
METRICS_HOST=0.0.0.0
METRICS_PORT=9464

# Origin used in links, the sitemap and the OpenAPI document.
PUBLIC_ORIGIN=https://api.dharun.dev

# 1 = take the client address from CF-Connecting-IP / X-Forwarded-For for rate limiting.
# Only correct when the port is reachable solely through your proxy.
TRUST_PROXY=1
# Allowance per minute per client (see below for what a request costs).
RATE_LIMIT_PER_MIN=600
# A lookup costs 1, a CPU-heavy request (image rendering, astronomy, live DNS) costs 10,
# a traceroute 20. 0 disables the limit.

# Cloudflare, optional. With both set, dharun-api-update purges everything Cloudflare
# has cached for PUBLIC_ORIGIN's hostname after each healthy deploy. The token needs
# Zone > Cache Purge (and Zone > Analytics > Read for the planned edge statistics).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# Optional, with their defaults:
# MAX_BODY_KB=256          largest POST body for the text endpoints
# HEAVY_CONCURRENCY=0      CPU-heavy requests run at once; 0 = one per CPU, the rest queue
# RENDER_CONCURRENCY=4     generated images rendered at once (each a short-lived process)
# RELOAD_SECONDS=15        how often the API looks for a refreshed dataset
# PNG_CACHE_MB=32          rendered PNG logos kept in memory
# LOG_REQUESTS=1           one JSON line per request on stdout (no client IPs)

# Free API keys (growth plan Part 2). Without ACCOUNTS_DB and ACCOUNTS_URL there are no
# accounts: keys are refused as unknown and the account pages answer 503.
#ACCOUNTS_DB=/var/lib/dharun-api/state/accounts/data.db
#ACCOUNTS_URL=http://127.0.0.1:8091
#KEY_RATE_LIMIT_PER_MIN=3000
#MODEL_QUOTA_PER_DAY=500
# The day keyless calls to the model endpoints stop working (midnight India time).
#KEY_REQUIRED_FROM=2026-12-15
# Signs the tool pages' tokens and the signup check; 32 random bytes. Unset: a new one
# at every start.
#SITE_SECRET=
#SITE_TOKEN_DAILY=10
#SIGNUPS_PER_DAY=5

# For the accounts unit (cmd/accounts), in its own env file:
#ACCOUNTS_DIR=/var/lib/dharun-api/state/accounts
#ACCOUNTS_ADDR=127.0.0.1:8091
#PUBLIC_ORIGIN=https://api.dharun.dev
# Login codes go by Amazon SES (ap-south-1), port 465 with TLS.
#SMTP_HOST=email-smtp.ap-south-1.amazonaws.com SMTP_PORT=465 SMTP_TLS=true
#SMTP_USERNAME= SMTP_PASSWORD=
#MAIL_FROM=no-reply@api.dharun.dev MAIL_FROM_NAME=India API

# For the refresh unit, in /etc/dharun-api/refresh.env (root, mode 600), not this file:
# the key of the Open Government Data Platform (data.gov.in), for the mandi and
# air-quality datasets. Without it they are skipped.
#DATA_GOV_IN_KEY=
