[Unit]
Description=api.dharun.dev: free, open APIs for Indian developers
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/dharun-api/current/api

[Service]
User=dharun-api
Group=dharun-api
WorkingDirectory=/opt/dharun-api/current
EnvironmentFile=/etc/dharun-api/env
# Datasets that came with the release. A deploy replaces them.
Environment=SEED_DIR=/opt/dharun-api/current/seed
# Datasets this server fetched itself (dharun-api-refresh). A deploy never touches them;
# for each dataset the more recent of the two copies is served.
Environment=DATA_DIR=/var/lib/dharun-api/data
# Lifetime request totals. systemd creates /var/lib/dharun-api for the service user.
StateDirectory=dharun-api
Environment=STATE_DIR=/var/lib/dharun-api
# Generated images are rendered by resvg, one short-lived process per image. The file
# tools run their programs (typst, piper, deep-filter, onnx-run from the release; tesseract,
# vips, ffmpeg, poppler from Debian) the same way.
Environment=RESVG=/opt/dharun-api/current/resvg
ExecStart=/opt/dharun-api/current/api
Restart=always
RestartSec=3
# The Go runtime collects harder as it nears this, trading processor time for memory.
# It is a target for the server itself; the programs it runs come on top, within
# MemoryMax. Measured (2026-10-15): a background removal peaks at 1 GB with the API, one
# at a time (MODEL_CONCURRENCY), Whisper 0.5 GB the same way; other file jobs 60 to 320 MB
# each, one per CPU at once. The text model helpers (onnx-run serve) hold up to
# TEXT_MODEL_MEMORY_MB, 2 GB by default, and the API about 400 MB of their tokenizers.
Environment=GOMEMLIMIT=768MiB
MemoryMax=6G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
